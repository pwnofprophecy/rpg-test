config_version=5

[application]

config/name="RPGTest"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://autoloads/game_manager.gd"
ModManager="*res://autoloads/mod_manager.gd"
